# Database URL (defaults to local SQLite file roundtable.db)
DATABASE_URL=sqlite+aiosqlite:///./roundtable.db

# Whisper model config (tiny.en for fast CPU inference, base.en, small.en, or large-v3)
WHISPER_MODEL_SIZE=tiny.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Voice Activity Detection Sensitivity (RMS energy threshold)
VAD_RMS_THRESHOLD=0.015

# Optional Cloud STT Acceleration (Groq provides ~150ms transcription)
GROQ_API_KEY=
OPENAI_API_KEY=
