# Frontend Cloud Configuration (.env)

# Backend REST API URL (leave empty for local dev proxy or specify e.g. https://api.yourdomain.com)
VITE_API_URL=

# Backend WebSocket URL (leave empty for local dev proxy or specify e.g. wss://api.yourdomain.com)
VITE_WS_URL=

# Public Frontend Domain (used in QR codes for mobile devices to join)
# For local network Wi-Fi testing: http://192.168.x.x:5173
# For production: https://roundtable.yourdomain.com
VITE_APP_URL=
